    { "id": "HtmlContainer1", "field_type": "html container", "color": "#000000", "font_family": "Consolas, monospace", "font_size": "14px", "font_style": "normal", "font_variant": "normal", "letter_spacing": "normal", "text_decoration": "none solid rgb(0, 0, 0)", "text_transform": "none", "word_spacing": "0px", "top": "85px", "left": "724px", "z_index": "10", "html": "<h2>Test Upload (WIP)</h2>\n<form id=\"uploadForm\">\n  <input type=\"hidden\" id=\"itemIdField\" name= value=\"12345\">\n  <input type=\"file\" id=\"imageFile\" accept=\"image/*\">\n  <button type=\"button\" onclick=\"uploadImage()\">Upload Image</button>\n</form>\n\n<script>\nfunction uploadImage() {\n  var fileInput = document.getElementById('imageFile');\n  var file = fileInput.files[0];\n  \n  if (!file) {\n    alert('Please select an image file to upload.');\n    return;\n  }\n\n  // Retrieve the item ID\n  var itemId = getItemId();\n  \n  // Extract the file extension\n  var fileName = file.name;\n  var fileExtension = fileName.substring(fileName.lastIndexOf('.'));\n  \n  // Create a new File object with the item ID as the name and the same file extension\n  var renamedFile = new File([file], itemId + fileExtension, { type: file.type });\n  \n  // Create a FormData object and append the renamed file\n  var formData = new FormData();\n  formData.append('image', renamedFile);\n  \n  // Construct the API URL using the current host but with a different port\n  var currentHost = window.location.hostname;\n  var apiPort = 5200;\n  var apiUrl = `http://${currentHost}:${apiPort}/item/create5`;\n  \n  fetch(apiUrl, {\n    method: 'POST',\n    body: formData\n  })\n  .then(response => response.json())\n  .then(data => {\n    if (data.success) {\n      alert('Image uploaded successfully!');\n    } else {\n      alert('Failed to upload image.');\n    }\n  })\n  .catch(error => {\n    console.error('Error:', error);\n    alert('An error occurred while uploading the image.');\n  });\n}\n\nfunction getItemId() {\n  // Retrieve item ID from a form field or a variable\n  return document.getElementById('itemIdField').value;\n}\n</script>", "white_space": "normal", "width": "200px", "height": "100px", "value": "script: value", "newitem": "true" }, 
